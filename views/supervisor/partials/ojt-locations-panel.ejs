<div class="card full-width">
  <div class="card-header">
    <div>
      <h2>OJT Site Locations</h2>
      <small>Set each student's internship GPS location and allowed radius. Select students at the same OJT site to update them together.</small>
    </div>
  </div>

  <% if (!bscsGroup.students.length) { %>
    <div class="empty-state program-empty-state">
      <div class="empty-icon">📍</div>
      <p>No students to configure</p>
    </div>
  <% } else { %>
    <div class="ojt-location-bulk-bar hidden" id="ojtLocationBulkBar" aria-live="polite">
      <span id="ojtLocationSelectedCount">0 selected</span>
      <button type="button" class="btn btn-primary btn-sm" id="ojtLocationBulkEditBtn">Set location for selected</button>
      <button type="button" class="btn btn-ghost btn-sm" id="ojtLocationClearSelectionBtn">Clear selection</button>
    </div>
    <div class="table-wrapper" data-search-label="OJT site locations">
      <table class="table supervisor-data-table ojt-locations-table">
        <thead>
          <tr>
            <th class="ojt-select-col" aria-label="Select students">
              <input type="checkbox" id="ojtLocationSelectAll" class="ojt-student-select-all" aria-label="Select all students" title="Select all">
            </th>
            <th>Student</th>
            <th>Status</th>
            <th>OJT Site</th>
            <th>Coordinates</th>
            <th>Radius</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% bscsGroup.students.forEach(function(s) {
            const hasSite = s.ojt_latitude != null && s.ojt_longitude != null;
            const locationSet = hasSite && (s.ojt_site_name || '').trim();
            const siteKey = hasSite
              ? ((s.ojt_site_name || '').trim().toLowerCase() + '|' + Number(s.ojt_latitude).toFixed(5) + '|' + Number(s.ojt_longitude).toFixed(5))
              : '';
          %>
            <tr data-ojt-row data-student-id="<%= s.id %>" data-site-key="<%= siteKey %>">
              <td class="ojt-select-col">
                <input
                  type="checkbox"
                  class="ojt-student-select"
                  data-ojt-select
                  data-student-id="<%= s.id %>"
                  data-student-name="<%= s.name %>"
                  data-site-key="<%= siteKey %>"
                  data-site-name="<%= s.ojt_site_name || '' %>"
                  data-latitude="<%= s.ojt_latitude != null ? s.ojt_latitude : '' %>"
                  data-longitude="<%= s.ojt_longitude != null ? s.ojt_longitude : '' %>"
                  data-radius="<%= s.ojt_radius_meters || 150 %>"
                  aria-label="Select <%= s.name %>"
                >
              </td>
              <td>
                <strong><%= s.name %></strong><br>
                <small style="color:var(--gray-600)"><%= s.email %></small>
              </td>
              <td>
                <% if (locationSet) { %>
                  <span class="status-badge status-approved ojt-location-set" title="OJT location configured">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M20 6L9 17l-5-5"/></svg>
                    Set
                  </span>
                <% } else { %>
                  <span class="status-badge status-pending ojt-location-unset" title="OJT location not configured yet">Not set</span>
                <% } %>
              </td>
              <td><%= s.ojt_site_name || '—' %></td>
              <td>
                <% if (hasSite) { %>
                  <%= Number(s.ojt_latitude).toFixed(5) %>, <%= Number(s.ojt_longitude).toFixed(5) %>
                <% } else { %>—<% } %>
              </td>
              <td><%= s.ojt_radius_meters || 150 %> m</td>
              <td>
                <div class="table-action-group">
                  <button
                    type="button"
                    class="table-icon-btn"
                    title="Edit OJT location"
                    aria-label="Edit OJT location for <%= s.name %>"
                    data-ojt-edit
                    data-student-id="<%= s.id %>"
                    data-student-name="<%= s.name %>"
                    data-site-name="<%= s.ojt_site_name || '' %>"
                    data-latitude="<%= s.ojt_latitude != null ? s.ojt_latitude : '' %>"
                    data-longitude="<%= s.ojt_longitude != null ? s.ojt_longitude : '' %>"
                    data-radius="<%= s.ojt_radius_meters || 150 %>"
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 21s7-4.5 7-10a7 7 0 1 0-14 0c0 5.5 7 10 7 10z"/><circle cx="12" cy="11" r="2.5"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div id="ojtLocationModal" class="feedback-modal hidden" aria-hidden="true">
  <div class="feedback-modal-backdrop" data-ojt-modal-close></div>
  <div class="feedback-modal-dialog feedback-modal-dialog-ojt" role="dialog" aria-labelledby="ojtLocationModalTitle" aria-modal="true">
    <div class="feedback-modal-header">
      <div>
        <h3 id="ojtLocationModalTitle">Edit OJT Location</h3>
        <p id="ojtLocationModalStudent"></p>
      </div>
      <button type="button" class="btn btn-ghost btn-sm" data-ojt-modal-close aria-label="Close">✕</button>
    </div>
    <form method="post" action="/supervisor/students/ojt-location" id="ojtLocationModalForm" class="ojt-location-form ojt-location-modal-form" data-noConfirm>
      <div id="ojtLocationStudentIds"></div>
      <input type="hidden" name="student_id" id="ojtLocationStudentId" value="">
      <div class="ojt-location-modal-map-row">
        <label class="ojt-location-map-label" for="ojtLocationMapPreview">Location preview</label>
        <div class="ojt-site-map ojt-location-map-preview">
          <iframe id="ojtLocationMapPreview" class="ojt-site-map-frame" title="OJT location preview" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
        </div>
      </div>
      <div class="ojt-location-modal-fields">
        <div class="form-group">
          <label for="ojtLocationSiteName">Site / Company name</label>
          <input type="text" id="ojtLocationSiteName" name="site_name" maxlength="200" placeholder="e.g. ABC Tech Office" required>
        </div>
        <div class="ojt-location-grid ojt-location-grid-modal">
          <div class="form-group">
            <label for="ojtLocationLat">Latitude</label>
            <input type="number" id="ojtLocationLat" name="latitude" step="any" class="ojt-lat-input" placeholder="e.g. 13.9416" required>
          </div>
          <div class="form-group">
            <label for="ojtLocationLng">Longitude</label>
            <input type="number" id="ojtLocationLng" name="longitude" step="any" class="ojt-lng-input" placeholder="e.g. 121.1631" required>
          </div>
          <div class="form-group">
            <label for="ojtLocationRadius">Radius (meters)</label>
            <input type="number" id="ojtLocationRadius" name="radius_meters" min="50" max="5000" step="1" value="150" required>
          </div>
        </div>
        <div class="ojt-location-modal-footer-row">
          <button type="button" class="btn btn-secondary btn-sm ojt-use-gps-btn" id="ojtLocationGpsBtn">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" style="vertical-align:-2px;margin-right:4px" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4l1.4-1.4M17 7l1.4-1.4"/></svg>
            Use My Current GPS
          </button>
          <small class="field-hint ojt-location-modal-hint">Tip: Use GPS or paste coordinates — site name auto-fills and you can edit it.</small>
        </div>
      </div>
      <div class="feedback-modal-actions">
        <button type="button" class="btn btn-cancel" data-ojt-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary" id="ojtLocationSaveBtn" data-loading-text="Saving…">Save Location</button>
      </div>
    </form>
  </div>
</div>
