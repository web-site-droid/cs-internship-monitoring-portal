<div class="card full-width">
  <div class="card-header">
    <div>
      <h2>Daily Tasks</h2>
      <small>Assign and monitor tasks for <%= typeof taskDate !== 'undefined' ? h.formatDate(taskDate) : 'today' %>.</small>
    </div>
  </div>

  <% if (!bscsGroup.students.length) { %>
    <div class="empty-state program-empty-state">
      <div class="empty-icon">📝</div>
      <p>No students to assign tasks</p>
    </div>
  <% } else { %>
    <div class="table-wrapper" data-search-label="Daily tasks">
      <table class="table supervisor-data-table">
        <thead>
          <tr>
            <th>Student</th>
            <th>Tasks Today</th>
            <th>Submitted</th>
            <th>Latest Task</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% bscsGroup.students.forEach(function(s) {
            const studentTasks = (typeof tasksByStudent !== 'undefined' && tasksByStudent[s.id]) ? tasksByStudent[s.id] : [];
            const submittedCount = studentTasks.filter(function(t) { return t.student_progress && t.proof_photo && t.status !== 'rejected'; }).length;
            const latestTask = studentTasks.length ? studentTasks[studentTasks.length - 1].title : '—';
          %>
            <tr>
              <td>
                <strong><%= s.name %></strong><br>
                <small style="color:var(--gray-600)"><%= s.email %></small>
              </td>
              <td><%= studentTasks.length %></td>
              <td><%= submittedCount %> / <%= studentTasks.length %></td>
              <td><%= latestTask %></td>
              <td>
                <div class="table-action-group">
                  <button
                    type="button"
                    class="table-icon-btn"
                    title="Add daily task"
                    aria-label="Add task for <%= s.name %>"
                    data-task-add
                    data-student-id="<%= s.id %>"
                    data-student-name="<%= s.name %>"
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                  </button>
                  <button
                    type="button"
                    class="table-icon-btn"
                    title="View tasks"
                    aria-label="View tasks for <%= s.name %>"
                    data-task-view
                    data-student-id="<%= s.id %>"
                    data-student-name="<%= s.name %>"
                    <%= studentTasks.length ? '' : 'disabled' %>
                  >
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>
                  </button>
                </div>
              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<div id="dailyTaskModal" class="feedback-modal hidden" aria-hidden="true">
  <div class="feedback-modal-backdrop" data-task-modal-close></div>
  <div class="feedback-modal-dialog" role="dialog" aria-labelledby="dailyTaskModalTitle" aria-modal="true">
    <div class="feedback-modal-header">
      <div>
        <h3 id="dailyTaskModalTitle">Add Daily Task</h3>
        <p id="dailyTaskModalStudent"></p>
      </div>
      <button type="button" class="btn btn-ghost btn-sm" data-task-modal-close aria-label="Close">✕</button>
    </div>
    <form method="post" action="/supervisor/students/daily-task" id="dailyTaskModalForm" data-noConfirm>
      <input type="hidden" name="student_id" id="dailyTaskStudentId" value="">
      <input type="hidden" name="task_date" value="<%= typeof taskDate !== 'undefined' ? taskDate : '' %>">
      <div class="form-group">
        <label for="dailyTaskTitle">Task title</label>
        <input type="text" id="dailyTaskTitle" name="title" maxlength="200" placeholder="e.g. Update inventory spreadsheet" required>
      </div>
      <div class="form-group">
        <label for="dailyTaskDescription">Description (optional)</label>
        <textarea id="dailyTaskDescription" name="description" rows="3" maxlength="1000" placeholder="Extra details for the student"></textarea>
      </div>
      <div class="feedback-modal-actions">
        <button type="button" class="btn btn-cancel" data-task-modal-close>Cancel</button>
        <button type="submit" class="btn btn-primary" data-loading-text="Adding…">Add Task</button>
      </div>
    </form>
  </div>
</div>

<div id="dailyTasksViewModal" class="feedback-modal hidden" aria-hidden="true">
  <div class="feedback-modal-backdrop" data-tasks-view-close></div>
  <div class="feedback-modal-dialog feedback-modal-dialog-wide" role="dialog" aria-labelledby="dailyTasksViewTitle" aria-modal="true">
    <div class="feedback-modal-header">
      <div>
        <h3 id="dailyTasksViewTitle">Today's Tasks</h3>
        <p id="dailyTasksViewStudent"></p>
      </div>
      <button type="button" class="btn btn-ghost btn-sm" data-tasks-view-close aria-label="Close">✕</button>
    </div>
    <div id="dailyTasksViewList" class="supervisor-tasks-view-list"></div>
    <div class="feedback-modal-actions">
      <button type="button" class="btn btn-secondary" data-tasks-view-close>Close</button>
    </div>
  </div>
</div>
