<%- include('../partials/layout-top') %>

<div class="card full-width">
  <div class="card-header">
    <div>
      <h2>Student Attendance</h2>
      <small>Open folders by date, then by time. Each time folder has an Excel attendance sheet to download and the pictures of who is present.</small>
    </div>
  </div>
  <% if (!explorer.children.length) { %>
    <div class="empty-state">
      <div class="empty-icon">📁</div>
      <p>No attendance yet</p>
      <small>Folders appear here after a student times in.</small>
    </div>
  <% } else { %>
    <div class="table-search-bar attendance-folder-search">
      <input type="search" id="fileExplorerSearch" class="table-search-input" placeholder="Search folders, sheets, or students…" aria-label="Search attendance folders">
      <span class="table-search-meta" id="fileExplorerMeta"></span>
    </div>
    <div class="file-explorer" id="fileExplorer">
      <div class="file-explorer-bar">
        <button type="button" id="fileExplorerBack" class="file-explorer-back" aria-label="Back">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <nav id="fileExplorerPath" class="file-explorer-path" aria-label="Folder path"></nav>
      </div>
      <div class="file-explorer-body">
        <div id="fileExplorerTree" class="file-explorer-tree" aria-label="Folders"></div>
        <div id="fileExplorerGrid" class="file-explorer-grid"></div>
      </div>
      <div id="fileExplorerStatus" class="file-explorer-status"></div>
    </div>
    <p id="fileExplorerEmpty" class="table-search-empty hidden">This folder is empty.</p>
  <% } %>
</div>

<% if (explorer.children.length) { %>
<script>
(function () {
  const root = <%- JSON.stringify(explorer).replace(/</g, '\\u003c') %>;
  let stack = [root];
  const backBtn = document.getElementById('fileExplorerBack');
  const pathEl = document.getElementById('fileExplorerPath');
  const treeEl = document.getElementById('fileExplorerTree');
  const gridEl = document.getElementById('fileExplorerGrid');
  const statusEl = document.getElementById('fileExplorerStatus');
  const emptyEl = document.getElementById('fileExplorerEmpty');
  const metaEl = document.getElementById('fileExplorerMeta');
  const searchEl = document.getElementById('fileExplorerSearch');

  const folderIcon = '<svg viewBox="0 0 48 40" aria-hidden="true"><path fill="#e7b008" d="M4 10a4 4 0 0 1 4-4h10l4 4h18a4 4 0 0 1 4 4v18a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V10z"/><path fill="#f6d365" d="M4 16h40v16a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V16z"/></svg>';
  const sheetIcon = '<svg viewBox="0 0 40 48" aria-hidden="true"><path fill="#15803d" d="M8 2h16l12 12v30a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V6a4 4 0 0 1 4-4z"/><path fill="#bbf7d0" d="M24 2v10a2 2 0 0 0 2 2h10"/><path fill="#fff" d="M10 24h20v2H10zm0 6h20v2H10zm0 6h14v2H10z"/></svg>';

  function current() {
    return stack[stack.length - 1];
  }

  function findPath(node, target, trail) {
    const next = trail.concat(node);
    if (node === target) return next;
    const children = node.children || [];
    for (let i = 0; i < children.length; i += 1) {
      if (children[i].type !== 'folder') continue;
      const found = findPath(children[i], target, next);
      if (found) return found;
    }
    return null;
  }

  function openNode(node) {
    if (node.type !== 'folder') return;
    const path = node === root ? [root] : findPath(root, node, []);
    if (!path) return;
    stack = path;
    render();
  }

  function iconFor(node) {
    const wrap = document.createElement('span');
    wrap.className = 'file-explorer-icon';
    if (node.type === 'photo') {
      const img = document.createElement('img');
      img.src = node.photoUrl;
      img.alt = '';
      wrap.appendChild(img);
      return wrap;
    }
    wrap.innerHTML = node.type === 'sheet' ? sheetIcon : folderIcon;
    return wrap;
  }

  function render() {
    const node = current();
    const query = (searchEl.value || '').trim().toLowerCase();
    const items = (node.children || []).filter((child) => {
      if (!query) return true;
      return `${child.name} ${child.search || ''} ${child.hint || ''}`.toLowerCase().includes(query);
    });

    backBtn.disabled = stack.length < 2;
    pathEl.replaceChildren();
    stack.forEach((crumb, index) => {
      if (index > 0) {
        const sep = document.createElement('span');
        sep.className = 'file-explorer-sep';
        sep.textContent = '>';
        pathEl.appendChild(sep);
      }
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'file-explorer-crumb' + (index === stack.length - 1 ? ' is-current' : '');
      button.textContent = crumb.name;
      button.addEventListener('click', () => openNode(crumb));
      pathEl.appendChild(button);
    });

    treeEl.replaceChildren();
    function addTreeItem(item, depth) {
      if (item.type !== 'folder') return;
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'file-explorer-tree-item' + (item === node ? ' is-current' : '');
      button.style.paddingLeft = `${8 + depth * 16}px`;
      button.textContent = item.name;
      button.addEventListener('click', () => openNode(item));
      treeEl.appendChild(button);
      const opened = stack.includes(item);
      if (opened) {
        (item.children || []).forEach((child) => addTreeItem(child, depth + 1));
      }
    }
    addTreeItem(root, 0);

    gridEl.replaceChildren();
    items.forEach((child) => {
      const el = child.type === 'sheet' ? document.createElement('a') : document.createElement('button');
      el.className = 'file-explorer-item';
      if (child.type === 'sheet') {
        el.href = child.href;
        el.setAttribute('download', child.name);
      } else {
        el.type = 'button';
      }
      if (child.type === 'photo') {
        el.classList.add('file-explorer-photo');
        el.dataset.photoUrl = child.photoUrl;
        el.dataset.photoTitle = child.photoTitle;
        el.dataset.photoLabel = child.photoLabel;
      }
      el.appendChild(iconFor(child));
      const label = document.createElement('span');
      label.className = 'file-explorer-label';
      label.textContent = child.name;
      el.appendChild(label);
      if (child.hint) {
        const hint = document.createElement('small');
        hint.textContent = child.hint;
        el.appendChild(hint);
      }
      if (child.type === 'folder') el.addEventListener('click', () => openNode(child));
      gridEl.appendChild(el);
    });

    const countLabel = `${items.length} item${items.length === 1 ? '' : 's'}`;
    statusEl.textContent = query ? `${countLabel} matching “${searchEl.value.trim()}”` : countLabel;
    if (metaEl) metaEl.textContent = countLabel;
    emptyEl.classList.toggle('hidden', items.length > 0);
  }

  backBtn.addEventListener('click', () => {
    if (stack.length < 2) return;
    stack.pop();
    render();
  });
  searchEl.addEventListener('input', render);
  render();
})();
</script>
<% } %>

<%- include('../partials/layout-bottom') %>
