<%- include('../partials/layout-top') %>

<div class="dashboard-grid">
  <div class="card">
    <h2>Send Notification</h2>
    <p style="color:var(--gray-600);margin-top:0">Broadcast an alert to students or partner companies.</p>
    <form method="post" action="/supervisor/notify" data-noConfirm>
      <div class="form-group">
        <label>Recipients</label>
        <select name="recipient" required>
          <option value="all_students">All Students</option>
          <option value="all_companies">All Companies</option>
          <% students.forEach(function(s) { %>
            <option value="<%= s.id %>">Student: <%= s.name %></option>
          <% }); %>
          <% companies.forEach(function(c) { %>
            <option value="<%= c.id %>">Company: <%= c.name %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group">
        <label>Subject</label>
        <input type="text" name="subject" placeholder="e.g. Internship deadline reminder">
      </div>
      <div class="form-group">
        <label>Message</label>
        <textarea name="message" rows="5" required data-maxlength="1000" placeholder="Write your notification..."></textarea>
      </div>
      <button type="submit" class="btn btn-primary" data-loading-text="Sending…">Send Notification</button>
    </form>
  </div>

  <div class="card">
    <h3 class="section-title">Tips</h3>
    <ul style="margin:0;padding-left:20px;color:var(--gray-600);line-height:2">
      <li>Notifications appear in each user's <strong>Notifications</strong> inbox (bell icon).</li>
      <li>Direct conversations stay in <strong>Messages</strong> only.</li>
      <li>Use clear subjects so students know what changed.</li>
      <li>Send reminders before clearance deadlines.</li>
    </ul>
  </div>
</div>

<%- include('../partials/layout-bottom') %>
