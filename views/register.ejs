<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register | Student Internship Monitoring Portal for LSSTI Programs</title>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/assets/js/notify.js" defer></script>
  <script src="/assets/js/buttons.js" defer></script>
</head>
<body class="login-page register-page">
  <div class="login-centered-wrap register-centered-wrap">
    <div class="login-centered-card register-card">
      <div class="auth-back-row">
        <a href="/login" class="login-back-btn register-back-btn" aria-label="Back to sign in">← Back</a>
      </div>
      <div class="register-header">
        <div class="register-header-main">
          <div class="brand-logo-mark brand-logo-mark-md">
            <img src="/img/comsie-logo.png" alt="Department of Computer Science LSSTI" class="login-logo register-logo">
          </div>
          <div class="register-header-text">
            <h2>Create an Account</h2>
            <p class="login-subtitle">Student Internship Monitoring Portal for LSSTI Programs</p>
          </div>
        </div>
      </div>

      <div class="register-body">
      <%- include('partials/flash') %>

      <form method="post" action="/register" class="login-form register-form" id="registerForm">
        <div class="register-split">
          <div class="register-split-col">
            <%- include('partials/personal-info-fields', { profile: {}, fieldPrefix: 'reg', defaultRole: 'student' }) %>
          </div>

          <div class="register-split-col register-split-security">
            <div class="pi-section pi-account-section">
              <div class="pi-section-head">
                <span class="pi-section-icon" aria-hidden="true">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </span>
                <h3 class="pi-section-title">Account Security</h3>
              </div>

              <div class="pi-grid pi-grid-stack">
                <div class="pi-field">
                  <label for="registerPassword">Password <span class="pi-required">*</span></label>
                  <div class="pi-input-wrap">
                    <span class="pi-input-icon" aria-hidden="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </span>
                    <input type="password" id="registerPassword" name="password" required minlength="6" placeholder="At least 6 characters" autocomplete="new-password">
                  </div>
                </div>

                <div class="pi-field">
                  <label for="confirmPassword">Confirm Password <span class="pi-required">*</span></label>
                  <div class="pi-input-wrap">
                    <span class="pi-input-icon" aria-hidden="true">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                    </span>
                    <input type="password" id="confirmPassword" name="confirm_password" required minlength="6" placeholder="Re-enter your password" autocomplete="new-password">
                  </div>
                </div>

                <div class="pi-field">
                  <label for="registerRole">Role <span class="pi-required">*</span></label>
                  <div class="pi-input-wrap pi-select-wrap">
                    <select id="registerRole" name="role" required>
                      <option value="student" selected>Student</option>
                      <option value="supervisor">Administrator</option>
                      <option value="school">Company / Partner</option>
                    </select>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="register-form-footer">
          <button type="submit" class="login-gradient-btn" data-loading-text="Creating account…">Register</button>
          <p class="login-register-link">Already have an account? <a href="/login">Sign in here</a></p>
        </div>
      </form>
      </div>
    </div>
  </div>

  <script>
    (function () {
      const roleSelect = document.getElementById('registerRole');
      const studentFields = document.querySelectorAll('[data-student-field]');
      const studentRequired = document.querySelectorAll('[data-student-required]');

      function syncStudentFields() {
        const isStudent = roleSelect.value === 'student';
        studentFields.forEach((el) => {
          el.classList.toggle('hidden', !isStudent);
        });
        studentRequired.forEach((el) => {
          el.required = isStudent;
        });
      }

      roleSelect.addEventListener('change', syncStudentFields);
      syncStudentFields();
    })();
  </script>
</body>
</html>
