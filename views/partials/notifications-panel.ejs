<div class="card notifications-page-card">
  <h2 class="inbox-heading">
    <span class="inbox-heading-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
    </span>
    Notifications
  </h2>

  <div class="notification-toolbar">
    <p class="notification-toolbar-summary">
      <% if (unreadCount > 0) { %>
        <strong><%= unreadCount %></strong> new notification<%= unreadCount === 1 ? '' : 's' %>
      <% } else { %>
        All caught up — no new notifications
      <% } %>
    </p>
    <div class="notification-toolbar-actions">
      <% if (typeof showSendLink !== 'undefined' && showSendLink) { %>
        <a href="<%= sendLinkHref || '/supervisor/notify' %>" class="btn btn-primary btn-sm"><%= sendLinkLabel || 'Send Notification' %></a>
      <% } %>
      <% if (unreadCount > 0) { %>
      <form method="post" action="<%= markReadAction %>" data-noConfirm data-noLoading>
        <button type="submit" class="btn btn-secondary btn-sm">Mark all as read</button>
      </form>
      <% } %>
    </div>
  </div>

  <% if (!notifications.length) { %>
    <div class="empty-state">
      <div class="empty-icon">🔔</div>
      <p>No notifications yet</p>
      <small><%= typeof emptyHint !== 'undefined' ? emptyHint : 'Alerts and updates will appear here.' %></small>
    </div>
  <% } else { %>
    <p class="inbox-count"><%= notifications.length %> notification<%= notifications.length === 1 ? '' : 's' %> — click to expand</p>
    <div class="inbox-scroll notifications-scroll" tabindex="0" aria-label="Notification list">
      <div class="notification-list notification-list-collapsible">
        <% notifications.forEach(function(n) {
          const unread = h.isNotificationUnread(n);
          const title = h.notificationTitle(n);
          const body = h.notificationBody(n);
          const preview = (body || '').replace(/\s+/g, ' ').trim();
          const shortPreview = preview.length > 72 ? preview.slice(0, 72) + '…' : preview;
          const isAlert = n.kind === 'alert';
          const isApproved = n.action === 'approved';
        %>
          <details class="notification-item-collapsible <%= unread ? 'unread' : 'read' %>">
            <summary class="notification-item-summary">
              <span class="notification-item-icon" aria-hidden="true">
                <% if (isAlert) { %>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                <% } else if (isApproved) { %>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <% } else { %>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <% } %>
              </span>
              <span class="notification-item-main">
                <span class="notification-item-title-row">
                  <strong><%= title %></strong>
                  <% if (unread) { %><span class="message-unread-dot" title="Unread"></span><% } %>
                </span>
                <span class="notification-item-preview">
                  <% if (n.from_name) { %>from <%= n.from_name %><% if (shortPreview) { %> · <% } %><% } %>
                  <%= shortPreview %>
                </span>
              </span>
              <span class="notification-status-badge <%= unread ? 'new' : 'read' %>"><%= unread ? 'New' : 'Read' %></span>
              <span class="notification-item-time"><%= h.formatDateTime(n.created_at) %></span>
              <span class="message-item-chevron" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
              </span>
            </summary>
            <div class="notification-item-body">
              <% if (n.from_name) { %><p class="notification-from">from <strong><%= n.from_name %></strong></p><% } %>
              <p class="notification-item-text"><%= body %></p>
              <time><%= h.formatDateTime(n.created_at) %></time>
            </div>
          </details>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>
