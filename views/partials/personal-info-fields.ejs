<%
  const p = typeof profile !== 'undefined' && profile ? profile : {};
  const idPrefix = typeof fieldPrefix !== 'undefined' ? fieldPrefix : '';
  const isStudentContext = typeof studentOnly !== 'undefined'
    ? studentOnly
    : (p.role === 'student' || (typeof defaultRole !== 'undefined' && defaultRole === 'student'));
  const showStudentFields = typeof hideStudentFields === 'undefined' || !hideStudentFields;
%>
<div class="pi-section">
  <div class="pi-section-head">
    <span class="pi-section-icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
    </span>
    <h3 class="pi-section-title">Personal Information</h3>
  </div>

  <div class="pi-grid">
    <div class="pi-field pi-field-fullname">
      <label for="<%= idPrefix %>firstName">Full Name <span class="pi-required">*</span></label>
      <div class="pi-name-row">
        <div class="pi-input-wrap">
          <span class="pi-input-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
          </span>
          <input type="text" id="<%= idPrefix %>firstName" name="first_name" required maxlength="50" placeholder="First name" autocomplete="given-name" value="<%= p.first_name || '' %>">
        </div>
        <div class="pi-input-wrap pi-mi-wrap">
          <input type="text" id="<%= idPrefix %>middleInitial" name="middle_initial" maxlength="5" placeholder="M.I." autocomplete="additional-name" value="<%= p.middle_initial || '' %>">
        </div>
        <div class="pi-input-wrap">
          <input type="text" id="<%= idPrefix %>lastName" name="last_name" required maxlength="50" placeholder="Last name" autocomplete="family-name" value="<%= p.last_name || '' %>">
        </div>
      </div>
    </div>

    <div class="pi-field">
      <label for="<%= idPrefix %>email">Email Address <span class="pi-required">*</span></label>
      <div class="pi-input-wrap">
        <span class="pi-input-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        </span>
        <input type="email" id="<%= idPrefix %>email" name="email" required maxlength="150" placeholder="your.email@example.com" autocomplete="email" value="<%= p.email || '' %>">
      </div>
    </div>

    <div class="pi-field">
      <label for="<%= idPrefix %>phone">Phone Number<% if (isStudentContext) { %> <span class="pi-required">*</span><% } %></label>
      <div class="pi-input-wrap">
        <span class="pi-input-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        </span>
        <input type="tel" id="<%= idPrefix %>phone" name="phone" maxlength="20" placeholder="e.g. 0917 123 4567" autocomplete="tel" value="<%= p.phone || '' %>" <%= isStudentContext ? 'required' : '' %>>
      </div>
    </div>

    <% if (showStudentFields) { %>
    <div class="pi-field pi-student-field" data-student-field>
      <label for="<%= idPrefix %>department">Department / Major <span class="pi-required pi-student-required">*</span></label>
      <div class="pi-input-wrap">
        <span class="pi-input-icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
        </span>
        <input type="text" id="<%= idPrefix %>department" name="department_major" maxlength="120" placeholder="e.g., Computer Science" data-student-required value="<%= p.course_program || h.PROGRAM_NAME %>">
      </div>
    </div>
    <% } %>
  </div>
</div>
