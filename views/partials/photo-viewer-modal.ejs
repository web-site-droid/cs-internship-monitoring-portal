<div id="photoViewerModal" class="feedback-modal hidden" aria-hidden="true">
  <div class="feedback-modal-backdrop" data-photo-viewer-close></div>
  <div class="feedback-modal-dialog photo-viewer-modal-dialog" role="dialog" aria-labelledby="photoViewerModalTitle" aria-modal="true">
    <div class="feedback-modal-header">
      <div>
        <h3 id="photoViewerModalTitle">Photo</h3>
        <p id="photoViewerModalSubtitle"></p>
      </div>
      <button type="button" class="btn btn-secondary btn-sm" data-photo-viewer-close aria-label="Close">Close</button>
    </div>
    <div class="photo-viewer-modal-body">
      <img id="photoViewerModalImg" src="" alt="Photo preview">
    </div>
  </div>
</div>
