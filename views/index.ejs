<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Internship Monitoring Portal for LSSTI Programs</title>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/assets/js/notify.js" defer></script>
  <script src="/assets/js/buttons.js" defer></script>
  <script src="/assets/js/app.js" defer></script>
</head>
<body class="landing-body">
  <header class="landing-header">
    <nav class="landing-nav">
      <a href="/" class="brand">
        <div class="brand-logo-mark">
          <img src="/img/comsie-logo.png" alt="Department of Computer Science LSSTI" class="landing-logo">
        </div>
        <span class="brand-text">
          <span class="brand-text-main">LSSTI Portal</span>
          <span class="brand-text-sub">Internship Monitoring</span>
        </span>
      </a>
      <div class="landing-nav-actions">
        <a href="#about" class="landing-nav-link">About Us</a>
        <a href="#contact" class="landing-nav-link">Contact Us</a>
      </div>
    </nav>
  </header>

  <section class="landing-hero-banner" id="home">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-bg-logo" aria-hidden="true"></div>
    <div class="hero-overlay"></div>
    <div class="hero-fade-bottom" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-content">
        <h1>Monitoring internships is our mission.</h1>
        <p>A centralized hub for students, administrators, and partner companies to manage OJT hours, reports, and clearance.</p>
        <a href="#signin" class="btn btn-primary hero-cta js-open-signin">Sign In</a>
      </div>
    </div>
  </section>

  <section class="landing-reputation" id="about">
    <h2>Our Platform</h2>
    <div class="reputation-grid">
      <article class="reputation-card">
        <div class="reputation-icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
        </div>
        <h3>Reliable Tracking</h3>
        <p>Accurate hour logs, geofenced time-in, and audit-ready records for every internship session.</p>
      </article>
      <article class="reputation-card">
        <div class="reputation-icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </div>
        <h3>Collaborative Teams</h3>
        <p>Students, administrators, and company partners work together through one shared portal.</p>
      </article>
      <article class="reputation-card">
        <div class="reputation-icon" aria-hidden="true">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </div>
        <h3>Smart Reports</h3>
        <p>Weekly progress reports, task submissions, and clearance summaries generated automatically.</p>
      </article>
    </div>
  </section>

  <section class="landing-gallery" id="features">
    <div class="landing-gallery-text">
      <h2>Internship life, captured</h2>
      <p>From campus to the workplace — document your OJT journey with photos, logs, and validated records.</p>
    </div>
    <div class="landing-gallery-grid">
      <figure class="gallery-item gallery-item-large">
        <img src="/img/gallery-team.png" alt="LSSTI students and faculty together" loading="lazy">
        <figcaption>Team collaboration</figcaption>
      </figure>
      <figure class="gallery-item">
        <img src="/img/gallery-lab.png" alt="Students working in the computer laboratory" loading="lazy">
        <figcaption>Workplace OJT</figcaption>
      </figure>
      <figure class="gallery-item">
        <img src="/img/gallery-computers.png" alt="Students using computers in class" loading="lazy">
        <figcaption>Daily logging</figcaption>
      </figure>
    </div>
  </section>

  <section class="landing-roles-section" id="roles">
    <h2>Who are you?</h2>
    <p class="landing-roles-sub">Select your role to sign in and access your dashboard.</p>
    <div class="role-cards role-cards-landing">
      <a href="#signin" class="role-card role-card-stack js-open-signin" data-role="student" data-login-role>
        <div class="role-card-photo">
          <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=600&q=80" alt="Students working together">
        </div>
        <div class="role-card-body">
          <div class="role-icon">🎓</div>
          <h3>Student</h3>
          <p>Log hours, submit reports, view clearance status, and receive notifications.</p>
        </div>
      </a>
      <a href="#signin" class="role-card role-card-stack js-open-signin" data-role="admin" data-login-role>
        <div class="role-card-photo">
          <img src="https://images.unsplash.com/photo-1600880292203-757bb62b4baf?auto=format&fit=crop&w=600&q=80" alt="Administrator team">
        </div>
        <div class="role-card-body">
          <div class="role-icon">🛡️</div>
          <h3>Administrator</h3>
          <p>Manage students, validate activities, generate clearance reports, and send notifications.</p>
        </div>
      </a>
      <a href="#signin" class="role-card role-card-stack js-open-signin" data-role="school" data-login-role>
        <div class="role-card-photo">
          <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=600&q=80" alt="Company office building">
        </div>
        <div class="role-card-body">
          <div class="role-icon">🏢</div>
          <h3>Company</h3>
          <p>Validate internship hours, review reports, and access performance records.</p>
        </div>
      </a>
    </div>
  </section>

  <footer class="landing-footer" id="contact">
    <div class="landing-footer-main">
      <div class="landing-footer-grid">
        <div class="landing-footer-col landing-footer-brand-col">
          <a href="/" class="landing-footer-logo-link">
            <div class="brand-logo-mark brand-logo-mark-sm">
              <img src="/img/comsie-logo.png" alt="Department of Computer Science LSSTI" class="landing-footer-logo">
            </div>
            <strong>LSSTI Portal</strong>
          </a>
          <p>Student Internship Monitoring Portal — connecting students, administrators, and partner companies for OJT tracking and clearance.</p>
        </div>

        <div class="landing-footer-col">
          <h4>Platform</h4>
          <ul>
            <li><a href="#home">Home</a></li>
            <li><a href="#about">Our Platform</a></li>
            <li><a href="#features">Features</a></li>
            <li><a href="#signin" class="js-open-signin">Sign In</a></li>
          </ul>
        </div>

        <div class="landing-footer-col">
          <h4>Portal</h4>
          <ul>
            <li><a href="#signin" class="js-open-signin">Student Login</a></li>
            <li><a href="#signin" class="js-open-signin">Administrator Login</a></li>
            <li><a href="#signin" class="js-open-signin">Company Login</a></li>
          </ul>
        </div>

        <div class="landing-footer-col">
          <h4>About</h4>
          <ul>
            <li><a href="#about">About LSSTI</a></li>
            <li><a href="#features">Internship Program</a></li>
            <li><a href="#signin" class="js-open-signin">Sign In</a></li>
            <li><a href="#signin" class="js-open-signin">Sign In</a></li>
          </ul>
        </div>

        <div class="landing-footer-col landing-footer-contact-col">
          <h4>Contact Us</h4>
          <a href="#signin" class="landing-footer-cta js-open-signin">Get in touch</a>
        </div>
      </div>
    </div>
    <div class="landing-footer-bar">
      <p>&copy; <%= new Date().getFullYear() %> LSSTI BSCS Internship Portal. All rights reserved.</p>
    </div>
  </footer>

  <button type="button" class="back-to-top" id="backToTop" hidden aria-label="Back to top">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 19V5"/><path d="m6 11 6-6 6 6"/></svg>
  </button>

  <div class="signin-modal<%= (typeof openSignin !== 'undefined' && openSignin) ? ' is-open' : '' %>" id="signinModal" <%= (typeof openSignin !== 'undefined' && openSignin) ? '' : 'hidden' %> role="dialog" aria-modal="true" aria-labelledby="signinTitle">
    <div class="signin-modal-backdrop" data-close-signin></div>
    <div class="signin-modal-dialog">
      <div class="login-centered-card">
        <button type="button" class="signin-modal-close" data-close-signin aria-label="Close sign in">&times;</button>
        <div class="login-header">
          <div class="brand-logo-mark brand-logo-mark-lg">
            <img src="/img/comsie-logo.png" alt="Department of Computer Science LSSTI" class="login-logo">
          </div>
          <p class="login-brand-name" id="signinTitle">
            Student Internship Monitoring Portal
            <span>for LSSTI Programs</span>
          </p>
        </div>
        <div class="login-body">
          <%- include('partials/flash') %>
          <form method="post" action="/login" id="loginForm" class="login-form">
            <div class="login-input-wrap">
              <span class="login-input-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </span>
              <input type="email" id="email" name="email" required placeholder="Email address" autocomplete="email">
            </div>
            <div class="login-input-wrap">
              <span class="login-input-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" id="password" name="password" required placeholder="Password" autocomplete="current-password">
            </div>
            <button type="submit" class="login-gradient-btn" data-loading-text="Signing in…">Login</button>
          </form>
          <p class="login-register-link">Accounts are created by an administrator.</p>
        </div>
      </div>
    </div>
  </div>

</body>
</html>
