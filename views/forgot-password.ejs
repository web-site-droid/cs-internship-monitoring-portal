<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Forgot Password | Student Internship Monitoring Portal for LSSTI Programs</title>
  <link rel="stylesheet" href="/assets/css/main.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="/assets/js/notify.js" defer></script>
  <script src="/assets/js/buttons.js" defer></script>
</head>
<body class="login-page">
  <% const resetSent = typeof sent !== 'undefined' && sent; %>
  <% const resetPhone = typeof phone !== 'undefined' ? phone : ''; %>
  <% const displayPhone = typeof maskedPhone !== 'undefined' && maskedPhone ? maskedPhone : resetPhone; %>
  <% const smsReady = typeof smsConfigured !== 'undefined' && smsConfigured;
     const smsDev = typeof smsDevMode !== 'undefined' && smsDevMode; %>
  <div class="login-centered-wrap">
    <div class="login-centered-card">
      <div class="auth-back-row">
        <a href="<%= resetSent ? '/forgot-password' : '/login' %>" class="login-back-btn" aria-label="<%= resetSent ? 'Start over' : 'Back to login' %>">← Back</a>
      </div>

      <div class="login-header">
        <div class="brand-logo-mark brand-logo-mark-lg">
          <img src="/img/comsie-logo.png" alt="Department of Computer Science LSSTI" class="login-logo">
        </div>
        <p class="login-brand-name">
          Student Internship Monitoring Portal
          <span>for LSSTI Programs</span>
        </p>
      </div>

      <div class="login-body">
        <div class="forgot-steps" aria-hidden="true">
          <span class="forgot-step <%= resetSent ? 'is-done' : 'is-active' %>">1</span>
          <span class="forgot-step-line <%= resetSent ? 'is-done' : '' %>"></span>
          <span class="forgot-step <%= resetSent ? 'is-active' : '' %>">2</span>
        </div>

        <% if (!resetSent && !smsReady) { %>
          <div class="auth-setup-notice" role="alert">
            Text messaging is not configured yet. Add <strong>SEMAPHORE_API_KEY</strong> or Twilio credentials to your <code>.env</code> file, then restart the server.
          </div>
        <% } else if (!resetSent && smsDev) { %>
          <div class="auth-setup-notice auth-setup-notice-info" role="status">
            <strong>SMS dev mode</strong> — reset codes are printed in the server console (no text message sent).
          </div>
        <% } %>

        <% if (!resetSent) { %>
          <h2 class="auth-page-title">Forgot Password</h2>
          <p class="auth-page-desc">Enter your registered mobile number. We'll send a 6-digit code by text message so you can set a new password.</p>

          <%- include('partials/flash') %>

          <form method="post" action="/forgot-password" class="login-form">
            <div class="login-input-wrap">
              <span class="login-input-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.81.36 1.6.7 2.35a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.73-1.27a2 2 0 0 1 2.11-.45c.75.34 1.54.57 2.35.7A2 2 0 0 1 22 16.92z"/></svg>
              </span>
              <input type="tel" id="forgotPhone" name="phone" required placeholder="e.g. 0917 123 4567" autocomplete="tel" inputmode="tel" maxlength="20" value="<%= resetPhone %>">
            </div>

            <button type="submit" class="login-gradient-btn" data-loading-text="Sending code…">Send Code by Text</button>
          </form>

          <p class="login-register-link">Remember your password? <a href="/login">Sign in</a></p>
        <% } else { %>
          <h2 class="auth-page-title">Enter Reset Code</h2>
          <p class="auth-page-desc">We sent a 6-digit code by text message to <strong><%= displayPhone %></strong>. Enter the code below with your new password.</p>

          <%- include('partials/flash') %>

          <form method="post" action="/reset-password" class="login-form">
            <input type="hidden" name="phone" value="<%= resetPhone %>">

            <div class="login-input-wrap">
              <span class="login-input-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h10M7 13h6"/></svg>
              </span>
              <input type="text" id="resetCode" name="code" required placeholder="6-digit code from text message" class="reset-code-input" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" autofocus>
            </div>

            <div class="login-input-wrap">
              <span class="login-input-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" id="newPassword" name="password" required placeholder="New password (min. 8 characters)" minlength="8" autocomplete="new-password">
            </div>

            <div class="login-input-wrap">
              <span class="login-input-icon" aria-hidden="true">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
              </span>
              <input type="password" id="confirmPassword" name="confirm_password" required placeholder="Confirm new password" minlength="8" autocomplete="new-password">
            </div>

            <button type="submit" class="login-gradient-btn" data-loading-text="Updating…">Change Password</button>
          </form>

          <form method="post" action="/forgot-password" class="forgot-resend-form">
            <input type="hidden" name="phone" value="<%= resetPhone %>">
            <input type="hidden" name="resend" value="1">
            <p class="login-register-link">Didn't receive the text? <button type="submit" class="forgot-resend-btn">Resend code</button></p>
          </form>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>
